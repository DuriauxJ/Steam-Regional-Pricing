library(quantmod)
Data <- read.csv("C:/Users/User/Desktop/Steam Regional Pricing/R/temp.csv")
START_DATE <- Sys.Date()
END_DATE <- seq(START_DATE, length = 2, by = "-3 months")[2]
# Currency codes, e.g. EUR, AED, JPY
Currencies <- unique(Data$currency_code_steam)
# Initialize the output column
Data$USD_regional_price_currency_exchange_rate <- NA_real_
for (currency in Currencies) {
# USD to USD is always 1
if (currency == "USD") {
rate <- 1
} else {
response <- request("https://api.frankfurter.dev/v2/rates") |>
req_url_query(
base = currency,
quotes = "USD",
from = as.character(END_DATE),
to = as.character(START_DATE)
) |>
req_perform()
rates <- fromJSON(resp_body_string(response))
rate <- if (nrow(rates) > 0) {
mean(rates$rate, na.rm = TRUE)
} else {
NA_real_
}
}
# Assign the rate to every matching row
Data$USD_regional_price_currency_exchange_rate[
Data$currency_code_steam == currency
] <- rate
}
